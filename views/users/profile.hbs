<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>使用者個人頁面</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      .profile-img { width: 100px; height: 100px; object-fit: cover;
      border-radius: 50%; } .restaurant-img { width: 50px; height: 50px;
      object-fit: cover; border-radius: 5px; }
    </style>
  </head>
  <body>
    <div class="container mt-5">
      <!-- 使用者資訊 -->
      <div class="card p-4">
        <div class="row align-items-center">
          <div class="col-md-2 text-center">
            <img src="{{user.image}}" alt="使用者大頭照" class="profile-img" />
          </div>
          <div class="col-md-8">
            <h4>{{user.name}}</h4>
            <p>{{user.email}}</p>
            <p>評論數: <span>{{comment.count}}</span></p>
          </div>
          <div class="col-md-2 text-end">
            <a href="/users/{{user.id}}/edit" class="btn btn-primary">編輯</a>
          </div>

        </div>
      </div>

      <!-- 使用者評論過的餐廳 -->
      <div class="mt-4">
        <h5>評論過的餐廳</h5>
        <ul class="list-group">
          {{#each comment.rows}}
            <li class="list-group-item d-flex align-items-center">
              <a
                href="/restaurants/{{this.Restaurant.id}}"
                class="d-flex align-items-center"
              >
                <img
                  src="{{this.Restaurant.image}}"
                  alt="餐廳圖片"
                  class="restaurant-img me-3"
                />
                <span>{{this.Restaurant.name}}</span>
              </a>
            </li>
          {{/each}}

        </ul>
      </div>

    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>
</html>